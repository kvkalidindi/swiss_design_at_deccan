{
  "$schema": "https://schema.example.com/intune-win32-app/v1",
  "_comment": "Example metadata for Intune Win32 app deployment of the Deccan design system. Adapt and import into Intune via Microsoft Endpoint Manager admin center; this JSON is not consumed directly by Intune APIs.",
  "displayName": "Deccan Fine Chemicals Design System",
  "description": "IBM Plex Sans/Mono fonts, Deccan-branded Office theme, and Word/PowerPoint/Excel templates. Per-user install. Configures HKCU registry so Office discovers the templates in File > New > Personal.",
  "publisher": "Deccan Fine Chemicals",
  "version": "0.5.0",
  "installCommandLine": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\install.ps1",
  "uninstallCommandLine": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\install.ps1 -Uninstall",
  "installExperience": {
    "runAsAccount": "user",
    "deviceRestartBehavior": "suppress"
  },
  "detectionRules": [
    {
      "type": "script",
      "scriptFile": "detection.ps1",
      "runAs32Bit": false,
      "enforceSignatureCheck": false
    }
  ],
  "requirements": {
    "applicableArchitectures": ["x64"],
    "minimumOperatingSystem": {
      "windows10": "10.0.19041"
    },
    "minimumSupportedWindowsRelease": "1903"
  },
  "returnCodes": [
    { "returnCode": 0,    "type": "success" },
    { "returnCode": 1707, "type": "success" },
    { "returnCode": 3010, "type": "softReboot" },
    { "returnCode": 1641, "type": "hardReboot" },
    { "returnCode": 1618, "type": "retry" }
  ],
  "assignments": {
    "_comment": "Adjust group IDs to match your tenant.",
    "required": [
      { "groupId": "GROUP_ID_DECCAN_USERS_HERE" }
    ]
  }
}
